{
  "name": "@luxxie/api",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@luxxie/schemas": "1.0.0",
    "@luxxie/types": "1.0.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/swagger": "^11.2.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6"
  }
}
